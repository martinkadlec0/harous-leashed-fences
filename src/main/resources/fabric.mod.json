{
	"schemaVersion": 1,
	"id": "harous-leashed-fences",
	"version": "${version}",
	"name": "Harou's Leashed Fences",
	"description": "Allows to leash two fences together!",
	"authors": [
		"BSHarou"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/harous-leashed-fences",
		"sources": "https://github.com/martinkadlec0/harous-leashed-fences",
		"issues": "https://github.com/martinkadlec0/harous-leashed-fences/issues"
	},
	"license": "MIT",
	"icon": "assets/leashed-fences/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"harou.leashed_fences.LeashedFencesMod"
		],
		"client": [
			"harou.leashed_fences.LeashedFencesModClient"
		],
		"fabric-datagen": [
			"harou.leashed_fences.LeashedFencesModDataGenerator"
		]
	},
	"mixins": [
		"harous-leashed-fences.mixins.json"
	],
	"accessWidener": "harous-leashed-fences.classtweaker",
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=${minecraft_version} <${restrict_minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}